# Copy to .env and configure locally. Never commit real credentials.
DATABASE_URL=postgresql+psycopg://attendance:REPLACE_PASSWORD@localhost:5432/attendance
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
# False is for localhost / debug testing only. Use true with HTTPS.
COOKIE_SECURE=false
SESSION_HOURS=8
# Only used by the optional Docker Compose PostgreSQL service.
DB_PASSWORD=REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD
